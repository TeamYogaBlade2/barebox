# MediaTek MT6589 second-stage bootloader defconfig
# Targets barebox-dt-2nd.img (BOARD_GENERIC_DT), loaded by LK/preloader.
# DRAM and display framebuffer are pre-initialised by the primary bootloader.

# Architecture
CONFIG_ARCH_MEDIATEK=y
CONFIG_ARCH_MT6589=y
CONFIG_CPU_V7=y
CONFIG_MMU=y
CONFIG_CACHE_L2X0=y

# Generic DT image (2nd stage)
CONFIG_OFDEVICE=y
CONFIG_OF=y
CONFIG_OF_BAREBOX_DRIVERS=y
CONFIG_CMDLINE_EDITING=y

# Serial console (16550 compatible on MT6589)
CONFIG_DRIVER_SERIAL_NS16550=y
CONFIG_DRIVER_SERIAL_NS16550_OMIT_UART_USE_FOR_CONSOLE_DETECTION=y

# Clock
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_OF_PROVIDER=y

# Clocksource
CONFIG_CLOCKSOURCE_MEDIATEK=y

# Watchdog (kick only - keep alive while barebox runs)
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_MTK=y
CONFIG_WATCHDOG_AUTOSTART=n

# Storage: eMMC/SD via MSDC
CONFIG_MCI=y
CONFIG_MCI_MTK_MSDC=y
CONFIG_MCI_STARTUP=y

# Partition support
CONFIG_PARTITION=y
CONFIG_PARTITION_DISK_EFI=y
CONFIG_PARTITION_DISK_DOS=y

# USB (MUSB for OTG/DFU)
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_DRIVER_DFU=y
CONFIG_USB_GADGET_MASS_STORAGE=y

# Framebuffer for barebox log output
CONFIG_VIDEO=y
CONFIG_DRIVER_VIDEO_SIMPLE_FRAMEBUFFER=y
CONFIG_CONSOLE_FULL=y

# Filesystem
CONFIG_FS=y
CONFIG_FS_EXT4=y
CONFIG_FS_FAT=y
CONFIG_FS_FAT_WRITE=y
CONFIG_FS_TFTP=y

# Networking (for TFTP boot)
CONFIG_NET=y
CONFIG_NET_DHCP=y

# Boot
CONFIG_BOOT=y
CONFIG_BOOTM=y
CONFIG_BOOTM_OFTREE=y
CONFIG_BOOTM_LINUX=y
CONFIG_FASTBOOT=y
CONFIG_FASTBOOT_EXPORT_DEVICETREE=y

# Shell / commands
CONFIG_SHELL_HUSH=y
CONFIG_GLOB=y
CONFIG_COMMAND_SUPPORT=y
CONFIG_CMD_BOOT=y
CONFIG_CMD_BOOTM=y
CONFIG_CMD_EDIT=y
CONFIG_CMD_EXPORT=y
CONFIG_CMD_LOADB=y
CONFIG_CMD_LOADS=y
CONFIG_CMD_LOADY=y
CONFIG_CMD_MD=y
CONFIG_CMD_MM=y
CONFIG_CMD_MEMINFO=y
CONFIG_CMD_NAND=n
CONFIG_CMD_PARTITION=y
CONFIG_CMD_RESET=y
CONFIG_CMD_TIMEOUT=y
CONFIG_CMD_VERSION=y
CONFIG_CMD_MTEST=y
CONFIG_CMD_DT=y
CONFIG_CMD_OF_NODE=y
CONFIG_CMD_OF_PROPERTY=y
CONFIG_CMD_GPIO=y
CONFIG_CMD_MCI=y
CONFIG_CMD_USB=y

# GPIO
CONFIG_GPIOLIB=y

# Pinctrl
CONFIG_PINCTRL=y

# I2C (for PMIC / touchscreen)
CONFIG_I2C=y
CONFIG_I2C_GPIO=y

# Regulator (MT6320 PMIC)
CONFIG_REGULATOR=y

# MFD / PMIC
CONFIG_MFD=y

# Keypad input
CONFIG_INPUT=y
CONFIG_KEYBOARD_GPIO=y

# Misc
CONFIG_ERRNO_MESSAGES=y
CONFIG_PRINTF_FULL=y
CONFIG_KALLSYMS=y
CONFIG_DEBUG_INFO=y
CONFIG_MODULES=n

# LLVM/Clang compatibility
CONFIG_WERROR=n
